# Local zero-config SQLite database (auto-created on startup or db:migrate)
DATABASE_URL="file:./data/app.db"

# Optional PostgreSQL connection string for production / Docker Compose
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/pulseissues"

# Public URL for shareable issue filter links
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# Webhooks HMAC-SHA256 (opcional, ej. TraceLab http://localhost:3009/api/hook/ecosystem-bin)
WEBHOOK_URL=""
WEBHOOK_SECRET=""
